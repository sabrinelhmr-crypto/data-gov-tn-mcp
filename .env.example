# Serveur MCP
MCP_HOST=0.0.0.0 # Host de binding (127.0.0.1 pour dev local)
MCP_PORT=8000 # Port du serveur HTTP MCP
MCP_ENV=local # Environnement (local, preprod, prod, demo)

# API data.gov.tn
DATAGOV_API_ENV=prod # prod ou demo
# NOTE: l'URL du CDC renvoie 404; l'API CKAN live est sur catalog.data.gov.tn
DATAGOV_API_BASE_URL=https://catalog.data.gov.tn/api/3
DATAGOV_API_KEY= # Optionnel pour la phase 1 (read-only)
# Verification TLS (defaut true). false si le store CA local est incomplet (dev / proxy entreprise)
DATAGOV_API_VERIFY_SSL=true

# Logging
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Monitoring
SENTRY_DSN= # DSN Sentry pour error tracking
SENTRY_SAMPLE_RATE=1.0 # Taux d'echoantillonnage (0.0-1.0)
MATOMO_URL= # URL de l'instance Matomo
MATOMO_SITE_ID= # ID du site Matomo

# Securite
# Host autorises dans l'en-tete Host ; un Host inconnu recoit 421.
ALLOWED_HOSTS=data.gov.tn,www.data.gov.tn,catalog.data.gov.tn,mcp.data.gov.tn
# Origines navigateur autorisees. '*' est REFUSE au demarrage si MCP_ENV=prod.
# Exemple prod : ALLOWED_ORIGINS=https://mcp.data.gov.tn
ALLOWED_ORIGINS=* # A restreindre en production
# Si false, aucune origine n'est acceptee (les clients MCP sans Origin passent).
CORS_ENABLED=true
# Hotes de telechargement autorises pour download_and_parse_resource (C2).
# Vide = tout hote public resolu vers une IP publique est accepte.
# Separateur : virgule. Jocker accepte : *.data.gov.tn
# Exemple : DOWNLOAD_ALLOWED_HOSTS=*.data.gov.tn,catalog.agridata.tn
DOWNLOAD_ALLOWED_HOSTS=

# Performance
MAX_PAGE_SIZE=100 # Taille max de page pour query_resource_data
MAX_DOWNLOAD_SIZE_MB=100 # Taille max de fichier pour download_and_parse
REQUEST_TIMEOUT=30 # Timeout API data.gov.tn (secondes)

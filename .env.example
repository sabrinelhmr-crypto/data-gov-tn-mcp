# ServeurMCP
MCP_HOST=0.0.0.0 #Hostdebinding(127.0.0.1pourdevlocal)
MCP_PORT=8000 #PortduserveurHTTPMCP
MCP_ENV=local #Environnement(local,preprod,prod,demo)
# APIdata.gov.tn
DATAGOV_API_ENV=prod #prodoudemo
# NOTE: l'URL du CDC renvoie 404; l'API CKAN live est sur catalog.data.gov.tn
DATAGOV_API_BASE_URL=https://catalog.data.gov.tn/api/3
DATAGOV_API_KEY= #Optionnelpourlaphase1(read-only)
# Verification TLS (defaut true). false si le store CA local est incomplet (dev / proxy entreprise)
DATAGOV_API_VERIFY_SSL=true
# Logging
LOG_LEVEL=INFO #DEBUG,INFO,WARNING,ERROR,CRITICAL
# Monitoring
GeneratedbyKimi.ai
SENTRY_DSN= #DSNSentrypourerrortracking
SENTRY_SAMPLE_RATE=1.0 #Tauxd'échantillonnage(0.0-1.0)
MATOMO_URL= #URLdel'instanceMatomo
MATOMO_SITE_ID= #IDdusiteMatomo
# Sécurité
ALLOWED_HOSTS=data.gov.tn,www.data.gov.tn,catalog.data.gov.tn,mcp.data.gov.tn
ALLOWED_ORIGINS=* #Àrestreindreenproduction
CORS_ENABLED=true
# Performance
MAX_PAGE_SIZE=100 #Taillemaxdepagepourquery_resource_data
MAX_DOWNLOAD_SIZE_MB=100 #Taillemaxdefichierpourdownload_and_parse
REQUEST_TIMEOUT=30 #TimeoutAPIdata.gov.tn(secondes)

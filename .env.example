# ============================================================================
# Serveur MCP data.gov.tn
# ============================================================================
# Copy this file to .env and update with your actual configuration

# Serveur MCP
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_ENV=local

# API data.gov.tn
DATAGOV_API_ENV=prod
DATAGOV_API_BASE_URL=https://www.data.gov.tn/api/3
DATAGOV_API_KEY=

# Logging
LOG_LEVEL=INFO

# Monitoring - Sentry
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0

# Monitoring - Matomo
MATOMO_URL=
MATOMO_SITE_ID=

# Sécurité
ALLOWED_HOSTS=data.gov.tn,www.data.gov.tn,mcp.data.gov.tn
ALLOWED_ORIGINS=*
CORS_ENABLED=true

# Performance
MAX_PAGE_SIZE=100
MAX_DOWNLOAD_SIZE_MB=100
REQUEST_TIMEOUT=30
